<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.second.hand.trading.server.dao.SeckillOrderDao">
  <resultMap id="BaseResultMap" type="com.second.hand.trading.server.model.SeckillOrderModel">
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="seckill_id" jdbcType="BIGINT" property="seckillId" />
    <result column="order_id" jdbcType="BIGINT" property="orderId" />
    <result column="user_id" jdbcType="BIGINT" property="userId" />
    <result column="idle_id" jdbcType="BIGINT" property="idleId" />
    <result column="quantity" jdbcType="INTEGER" property="quantity" />
    <result column="status" jdbcType="TINYINT" property="status" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
  </resultMap>

  <sql id="Base_Column_List">
    id, seckill_id, order_id, user_id, idle_id, quantity, status, create_time
  </sql>

  <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" />
    from sh_seckill_order
    where id = #{id}
  </select>

  <select id="selectByUserAndSeckill" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" />
    from sh_seckill_order
    where user_id = #{userId} and seckill_id = #{seckillId}
  </select>

  <select id="selectByOrderId" parameterType="java.lang.Long" resultMap="BaseResultMap">
    select <include refid="Base_Column_List" />
    from sh_seckill_order
    where order_id = #{orderId}
  </select>

  <insert id="insert" keyColumn="id" keyProperty="id" parameterType="com.second.hand.trading.server.model.SeckillOrderModel" useGeneratedKeys="true">
    insert into sh_seckill_order (seckill_id, order_id, user_id, idle_id, quantity, status, create_time)
    values (#{seckillId}, #{orderId}, #{userId}, #{idleId}, #{quantity}, #{status}, #{createTime})
  </insert>

  <update id="updateStatusIfMatch">
    update sh_seckill_order
    set status = #{toStatus}
    where id = #{id}
      and status = #{fromStatus}
  </update>
</mapper>

